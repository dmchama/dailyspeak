# --- Database (PostgreSQL or Supabase Postgres connection string) ---
# Supabase: use the "Session pooler" string (port 5432 on *.pooler.supabase.com), not the direct connection.
DATABASE_URL=postgres://dailyspeak:dailyspeak@localhost:5432/dailyspeak
# Connections per server instance (default 3 on Vercel, 10 elsewhere)
DB_POOL_MAX=

# --- App ---
APP_URL=http://localhost:3000
# Random long string used to sign nothing secret client-side; protects the cron endpoint
CRON_SECRET=change-me-to-a-long-random-string

# --- AI (server-side only, never exposed to the browser) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Optional: point to an OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
# Per-request timeout for OpenAI calls, in ms
OPENAI_TIMEOUT_MS=45000

# --- Scheduler ---
# Built-in scheduler runs inside the Next.js server every N minutes.
# Set to "false" on Vercel / serverless, or when you use an external scheduler
# (Supabase pg_cron — see db/supabase-cron.sql — system cron, or `npm run worker`).
ENABLE_INTERNAL_SCHEDULER=true
SCHEDULER_INTERVAL_MINUTES=5
# /api/cron/daily stops starting new lesson generations after this many seconds (rest runs next tick)
CRON_TIME_BUDGET_SECONDS=200

# --- Web Push (generate with `npm run vapid`) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Email (SMTP). If SMTP_HOST is empty, emails are written to ./outbox as .json files
# (on Vercel they are skipped instead, because the filesystem is read-only) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="DailySpeak <no-reply@dailyspeak.app>"
